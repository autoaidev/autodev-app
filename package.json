{
  "name": "autodev-app",
  "version": "0.1.0",
  "productName": "AutoDev",
  "description": "AutoDev desktop app \u2014 manage autonomous AI agents",
  "main": "./out/main/index.js",
  "author": "autoaidev",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "pack": "npm run bundle:cli && npm run build && electron-builder --dir",
    "dist": "npm run bundle:cli && npm run build && electron-builder",
    "dist:win": "npm run bundle:cli && npm run build && bash scripts/build-win.sh",
    "bundle:cli": "node scripts/bundle-cli.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chokidar": "^3.6.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autodev-cli": "^1.4.29",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
