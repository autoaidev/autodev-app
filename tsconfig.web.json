{
  "compilerOptions": {
    "composite": true, "module": "ESNext", "moduleResolution": "Bundler",
    "target": "ES2022", "jsx": "react-jsx", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "baseUrl": ".", "paths": { "@renderer/*": ["src/renderer/src/*"] }
  },
  "include": ["src/renderer/src/**/*", "src/preload/*.d.ts"],
  "exclude": ["src/renderer/src/_archive"]
}
